{
  "name": "n8n-nodes-genius-referrals",
  "version": "0.1.0",
  "description": "n8n community node for the Genius Referrals API.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "node -e \"console.log('Lint not configured yet; tracked in docs/release-readiness.md.')\"",
    "test": "npm run build && node --test test/**/*.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeniusReferrals/n8n-nodes-genius-referrals.git"
  },
  "homepage": "https://github.com/GeniusReferrals/n8n-nodes-genius-referrals#readme",
  "bugs": {
    "url": "https://github.com/GeniusReferrals/n8n-nodes-genius-referrals/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "genius-referrals",
    "referrals"
  ],
  "author": "Genius Referrals",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GeniusReferralsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GeniusReferrals/GeniusReferrals.node.js"
    ]
  }
}
