{
  "name": "n8n-nodes-genius-referrals",
  "version": "0.1.4",
  "description": "n8n community node for the Genius Referrals API.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "icons"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "n8n-node lint",
    "release:prepare": "node scripts/verify-approved-release.cjs --manifest release-manifest.json",
    "release:scan-community": "node scripts/verify-community-scan.cjs --manifest release-manifest.json",
    "release:verify-approved": "node scripts/verify-approved-release.cjs --manifest release-manifest.json",
    "release:verify-artifact": "node scripts/verify-prepared-artifact.cjs --manifest release-manifest.json",
    "release:verify-approval": "node scripts/verify-production-approval.cjs --manifest release-manifest.json",
    "release:verify-published": "node scripts/verify-published-package.cjs --manifest release-manifest.json",
    "test": "npm run build && node test/run-tests.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeniusReferrals/n8n-nodes-genius-referrals.git"
  },
  "homepage": "https://github.com/GeniusReferrals/n8n-nodes-genius-referrals#readme",
  "bugs": {
    "url": "https://github.com/GeniusReferrals/n8n-nodes-genius-referrals/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "genius-referrals",
    "referrals"
  ],
  "author": {
    "name": "Genius Referrals",
    "email": "support@geniusreferrals.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.41.2",
    "typescript": "^5.9.2"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GeniusReferralsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GeniusReferrals/GeniusReferrals.node.js"
    ]
  }
}
